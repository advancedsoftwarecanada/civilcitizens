[req]
default_bits = 2048
prompt = no
default_md = sha256
x509_extensions = v3_req
distinguished_name = dn

[dn]
C = CA
ST = Ontario
L = Toronto
O = Civil Citizens Dev
OU = Dev App
CN = civilcitizens.ca

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = civilcitizens.ca
DNS.2 = www.civilcitizens.ca
DNS.3 = dev.civilcitizens.ca
DNS.4 = localhost
IP.1 = 127.0.0.1
