generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  handle                    String               @unique
  name                      String?
  bio                       String?
  avatarUrl                 String?
  coverUrl                  String?
  passwordHash              String
  lastLoginAt               DateTime?
  resetToken                String?              @unique
  resetExpires              DateTime?
  createdAt                 DateTime             @default(now())
  avatarMediaId             String?              @unique
  coverMediaId              String?              @unique
  avatarPostId              String?              @unique
  coverPostId               String?              @unique
  billingAddress1           String?
  billingAddress2           String?
  billingCity               String?
  billingCompanyName        String?
  billingCountry            String?
  billingEmail              String?
  billingFirstName          String?
  billingLastName           String?
  billingNotes              String?
  billingPhone              String?
  billingPostalCode         String?
  billingState              String?
  billingTaxId              String?
  premiumCanceledAt         DateTime?
  premiumCancellationReason String?
  premiumPaymentFingerprint String?
  premiumRenewsAt           DateTime?
  premiumSince              DateTime?
  premiumStatus             PremiumStatus        @default(NONE)
  stripeCustomerId          String?              @unique
  stripePriceId             String?
  stripeSubscriptionId      String?              @unique
  businesses                Business[]
  businessMemberships       BusinessMembership[]
  businessFollows           BusinessFollow[]
  blockedBusinesses         BusinessBlock[]      @relation("UserBlockedBusinesses")
  blockedUsers              UserBlock[]          @relation("UserBlocksCreated")
  blockedByUsers            UserBlock[]          @relation("UserBlocksReceived")
  communityFollows          CommunityFollow[]
  comments                  Comment[]
  commentVotes              CommentVote[]
  contentReportsFiled       ContentReport[]      @relation("ContentReportReporter")
  contentReportsReviewed    ContentReport[]      @relation("ContentReportReviewer")
  contentReportsTargeting   ContentReport[]      @relation("ContentReportSubjectUser")
  supportRequestsFiled      SupportRequest[]     @relation("SupportRequestRequester")
  supportRequestsReviewed   SupportRequest[]     @relation("SupportRequestReviewer")
  experiences               Experience[]
  mediaAssets               MediaAsset[]         @relation("UserMediaAssets")
  posts                     Post[]
  pollVotes                 PollVote[]
  avatarMedia               MediaAsset?          @relation("AvatarMedia", fields: [avatarMediaId], references: [id])
  coverMedia                MediaAsset?          @relation("CoverMedia", fields: [coverMediaId], references: [id])
  avatarPost                Post?                @relation("AvatarPost", fields: [avatarPostId], references: [id])
  coverPost                 Post?                @relation("CoverPost", fields: [coverPostId], references: [id])
  votes                     Vote[]
  postReactions             PostReaction[]
  friendshipsRequested      Friendship[]         @relation("friendshipsRequested")
  friendshipsReceived       Friendship[]         @relation("friendshipsReceived")
  connectionsRequested      Connection[]         @relation("connectionsRequested")
  connectionsReceived       Connection[]         @relation("connectionsReceived")
  messageParticipants       MessageParticipant[]
  messagesSent              Message[]
  initiatedMessageCalls     MessageCall[]        @relation("MessageCallInitiator")
  endedMessageCalls         MessageCall[]        @relation("MessageCallEndedBy")
  familyMembers             FamilyMember[]       @relation("FamilyMembersParent")
  familyMemberDrafts        FamilyMemberDraft[]  @relation("FamilyMemberDraftsParent")
  familyFeedPosts           FamilyFeedPost[]     @relation("FamilyFeedPostsParent")
  jobPostingsCreated        JobPosting[]          @relation("JobPostingCreator")
  jobApplications           JobApplication[]
  jobPromotionsCreated      JobPromotion[]        @relation("JobPromotionCreator")
  jobAnalyticsEvents        JobAnalyticsEvent[]   @relation("JobAnalyticsActor")
  pushSubscriptions         PushSubscription[]
  communityMeta             Json?
  lastViewedHomeAt          DateTime?
  lastViewedFriendsAt       DateTime?
  lastViewedCommunitiesAt   DateTime?
}

model FamilyMember {
  id             String    @id @default(cuid())
  parentId       String
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  relationship   String
  friendCode     String    @unique
  username       String?   @unique
  avatarUrl      String?
  coverUrl       String?
  allowChildOwnMediaEdits      Boolean   @default(false)
  allowChildOwnUsernameEdits   Boolean   @default(true)
  allowChildAudioCalls         Boolean   @default(true)
  allowChildVideoCalls         Boolean   @default(true)
  notifyParentOnMediaChanges   Boolean   @default(false)
  suspendedAt    DateTime?
  suspendedById  String?
  suspensionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent        User             @relation("FamilyMembersParent", fields: [parentId], references: [id], onDelete: Cascade)
  familyFeedPosts FamilyFeedPost[]

  @@index([parentId, createdAt])
}

model FamilyMemberDraft {
  id           String    @id @default(cuid())
  parentId     String
  firstName    String?
  lastName     String?
  dateOfBirth  DateTime?
  relationship String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  parent User @relation("FamilyMemberDraftsParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, updatedAt])
}

model FamilyFeedPost {
  id             String       @id @default(cuid())
  parentId       String
  familyMemberId String
  body           String
  images         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  parent       User         @relation("FamilyFeedPostsParent", fields: [parentId], references: [id], onDelete: Cascade)
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@index([familyMemberId, createdAt])
  @@index([parentId, createdAt])
}

model Post {
  id             String        @id @default(cuid())
  authorId       String
  businessId     String?
  showBusinessAuthor Boolean   @default(false)
  moderationStatus ModerationStatus @default(VISIBLE)
  audience       String        @default("friends")
  visibility     String        @default("public")
  body           String
  title          String?
  type           String        @default("post")
  mediaUrl       String?
  images         Json?
  seoSlug        String?       @unique
  jurisdiction   String        @default("self")
  provinceCode   String?
  communitySlug  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  upvotes        Int           @default(0)
  downvotes      Int           @default(0)
  score          Int           @default(0)
  commentCount   Int           @default(0)
  hotScore       Float         @default(0)
  reactionMaple  Int           @default(0)
  reactionHeart  Int           @default(0)
  reactionHaha   Int           @default(0)
  reactionWow    Int           @default(0)
  reactionSad    Int           @default(0)
  reactionFire   Int           @default(0)
  reactionTotal  Int           @default(0)
  recentPositive Int           @default(0)
  lastActivityAt DateTime      @default(now())
  comments       Comment[]
  author         User          @relation(fields: [authorId], references: [id])
  business       Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  avatarOwner    User?         @relation("AvatarPost")
  coverOwner     User?         @relation("CoverPost")
  hashtags       PostHashtag[]
  votes          Vote[]
  reactions      PostReaction[]
  poll           Poll?
  sharedPostId   String?
  sharedPost     Post?         @relation("SharedPost", fields: [sharedPostId], references: [id])
  shares         Post[]        @relation("SharedPost")

  @@index([authorId, createdAt])
  @@index([businessId, createdAt])
  @@index([moderationStatus, createdAt])
  @@index([provinceCode, communitySlug, createdAt])
  @@index([jurisdiction, createdAt])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  moderationStatus ModerationStatus @default(VISIBLE)
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  upvotes   Int           @default(0)
  downvotes Int           @default(0)
  score     Int           @default(0)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     CommentVote[]

  @@index([postId, createdAt])
  @@index([postId, parentId, createdAt])
  @@index([moderationStatus, createdAt])
}

model CommentVote {
  userId    String
  commentId String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model Vote {
  userId    String
  postId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model PostReaction {
  userId    String
  postId    String
  type      ReactionType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([type])
  @@index([postId, createdAt])
}

model Poll {
  id                 String                @id @default(cuid())
  postId             String                @unique
  resultsVisibility  PollResultsVisibility
  resultsAvailableAt DateTime?
  firstVoteAt        DateTime?
  endedAt            DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  post               Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  options            PollOption[]
  votes              PollVote[]

  @@index([resultsVisibility, resultsAvailableAt])
  @@index([endedAt])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@unique([pollId, sortOrder])
  @@index([pollId, createdAt])
}

model PollVote {
  pollId                    String
  userId                    String
  optionId                  String
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  resultNotificationSentAt  DateTime?
  poll                      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option                    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([optionId])
  @@index([userId])
  @@index([resultNotificationSentAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  actorId   String
  postId    String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id            String      @id @default(cuid())
  userId        String
  endpoint      String      @unique
  p256dh        String
  auth          String
  userAgent     String?
  platform      PushPlatform @default(unknown)
  browser       PushBrowser  @default(unknown)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount  Int         @default(0)
  isActive      Boolean     @default(true)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([isActive, updatedAt])
  @@map("PushSubscriptions")
}

model PageView {
  id        String   @id @default(cuid())
  userId    String?
  path      String
  postId    String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([postId, createdAt])
}

model Friendship {
  id           String           @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       FriendshipStatus @default(PENDING)
  requestedAt  DateTime         @default(now())
  respondedAt  DateTime?

  requester User @relation("friendshipsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("friendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Connection {
  id           String           @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       ConnectionStatus @default(PENDING)
  requestedAt  DateTime         @default(now())
  respondedAt  DateTime?

  requester User @relation("connectionsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("connectionsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model MessageThread {
  id            String             @id @default(cuid())
  type          MessageThreadType  @default(direct)
  uniqueKey     String?            @unique
  contextType   String?
  contextId     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  lastMessageAt DateTime?          @default(now())
  messages      Message[]
  participants  MessageParticipant[]
  calls         MessageCall[]

  @@index([lastMessageAt])
}

model MessageParticipant {
  threadId       String
  userId         String
  role           MessageParticipantRole @default(member)
  joinedAt       DateTime                @default(now())
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  lastActivityAt DateTime                @default(now())
  thread         MessageThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@index([threadId, lastActivityAt])
}

model Message {
  id          String      @id @default(cuid())
  threadId    String
  senderId    String
  body        String?
  attachments Json?
  messageType MessageType @default(text)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model MessageCall {
  id            String            @id @default(cuid())
  threadId      String
  initiatorId   String
  endedByUserId String?
  roomId        String            @unique
  mode          MessageCallMode
  status        MessageCallStatus @default(ringing)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  startedAt     DateTime?
  lastJoinedAt  DateTime?
  endedAt       DateTime?
  thread        MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  initiator     User              @relation("MessageCallInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  endedByUser   User?             @relation("MessageCallEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([threadId, endedAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PushPlatform {
  android
  ios
  desktop
  unknown
}

enum PushBrowser {
  chrome
  edge
  safari
  unknown
}

enum PollResultsVisibility {
  AFTER_VOTE
  AFTER_6_HOURS
  AFTER_12_HOURS
  AFTER_24_HOURS
  AFTER_48_HOURS
}

enum ReactionType {
  maple
  heart
  haha
  wow
  sad
  fire
}

model FeedEntry {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model CommunityFollow {
  id           String   @id @default(cuid())
  userId       String
  provinceCode String
  communitySlug  String
  home         Boolean  @default(false)
  lastViewedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provinceCode, communitySlug])
  @@index([userId])
  @@index([provinceCode, communitySlug])
}

model Province {
  code        String   @id
  name        String
  shortName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  divisions   CensusDivision[]
  subdivisions CensusSubdivision[]
  fsas        ForwardSortationArea[]
  cities      City[]
}

model CensusDivision {
  id            String   @id
  provinceCode  String
  name          String
  type          String?
  population    Int?
  areaKm2       Float?
  centroidLat   Float?
  centroidLng   Float?
  bbox          Json?
  geometry      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  province      Province @relation(fields: [provinceCode], references: [code])
  subdivisions  CensusSubdivision[]
  fsas          ForwardSortationArea[]

  @@index([provinceCode])
}

model CensusSubdivision {
  id                  String   @id
  provinceCode        String
  divisionId          String
  name                String
  type                String?
  slug                String
  officialName        String?
  population          Int?
  areaKm2             Float?
  centroidLat         Float?
  centroidLng         Float?
  bbox                Json?
  geometry            Json?
  defaultCommunitySlug  String?
  defaultCommunityName  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  province            Province       @relation(fields: [provinceCode], references: [code])
  division            CensusDivision @relation(fields: [divisionId], references: [id])
  cities              City[]
  fsas                ForwardSortationArea[]

  @@unique([provinceCode, slug])
  @@index([provinceCode])
  @@index([divisionId])
}

model ForwardSortationArea {
  code               String  @id
  provinceCode       String
  divisionId         String?
  subdivisionId      String?
  subdivisionName    String?
  centroidLat        Float?
  centroidLng        Float?
  bbox               Json?
  geometry           Json?
  defaultCommunitySlug String?
  defaultCommunityName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  province           Province?        @relation(fields: [provinceCode], references: [code])
  division           CensusDivision?  @relation(fields: [divisionId], references: [id])
  subdivision        CensusSubdivision? @relation(fields: [subdivisionId], references: [id])

  @@index([provinceCode])
  @@index([divisionId])
  @@index([subdivisionId])
}

model City {
  id              String   @id @default(cuid())
  provinceCode    String
  name            String
  slug            String
  communitySlug   String
  communityName   String
  latitude        Float
  longitude       Float
  population      Int?
  source          String   @default("geonames_ca")
  sourceId        String
  featureClass    String?
  featureCode     String?
  matchMethod     String
  matchConfidence String
  matchDistanceKm Float?
  censusSubdivisionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  censusSubdivision CensusSubdivision? @relation(fields: [censusSubdivisionId], references: [id])
  province Province? @relation(fields: [provinceCode], references: [code])

  @@unique([provinceCode, slug])
  @@unique([source, sourceId])
  @@index([communitySlug])
  @@index([provinceCode])
  @@index([latitude, longitude])
  @@index([censusSubdivisionId])
}

model Hashtag {
  tag       String        @id
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  postId String
  tag    String
  post   Post    @relation(fields: [postId], references: [id])
  hash   Hashtag @relation(fields: [tag], references: [tag])

  @@id([postId, tag])
  @@index([tag])
}

model Experience {
  id           String    @id @default(cuid())
  userId       String
  title        String
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String?
  position     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([userId, startDate])
}

model MediaAsset {
  id            String           @id @default(cuid())
  ownerId       String
  category      MediaCategory
  assetType     MediaAssetType   @default(image)
  storageType   MediaStorageType @default(minio)
  originalKey   String
  mime          String
  byteSize      Int
  width         Int?
  height        Int?
  durationMs    Int?
  checksum      String?
  status        MediaStatus      @default(pending)
  failureReason String?
  variants      Json?
  metadata      Json?
  readyAt       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  logoBusiness  Business?        @relation("BusinessLogoMedia")
  coverBusiness Business?        @relation("BusinessCoverMedia")
  owner         User             @relation("UserMediaAssets", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOwner   User?            @relation("AvatarMedia")
  coverOwner    User?            @relation("CoverMedia")

  @@index([ownerId, category])
  @@index([status])
}

model Business {
  id                   String               @id @default(cuid())
  ownerId              String
  provinceCode         String?
  communitySlug        String?
  name                 String
  slug                 String
  type                 BusinessType         @default(LOCAL_BUSINESS)
  description          String?
  phone                String?
  websiteUrl           String?
  address              String?
  schedule             String?
  logoMediaId          String?              @unique
  coverMediaId         String?              @unique
  status               BusinessStatus       @default(DRAFT)
  moderationStatus     ModerationStatus     @default(VISIBLE)
  isVerified           Boolean              @default(false)
  logoUrl              String?
  coverUrl             String?
  stripeSubscriptionId String?              @unique
  stripePriceId        String?
  billingEmail         String?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  logoMedia            MediaAsset?          @relation("BusinessLogoMedia", fields: [logoMediaId], references: [id])
  coverMedia           MediaAsset?          @relation("BusinessCoverMedia", fields: [coverMediaId], references: [id])
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships          BusinessMembership[]
  follows              BusinessFollow[]
  blockedByUsers       BusinessBlock[]      @relation("BusinessBlockedByUsers")
  contentReports       ContentReport[]      @relation("ContentReportSubjectBusiness")
  posts                Post[]
  jobPostings          JobPosting[]
  jobAnalyticsEvents   JobAnalyticsEvent[]

  @@unique([provinceCode, communitySlug, slug])
  @@index([ownerId])
  @@index([status, moderationStatus])
  @@index([provinceCode, communitySlug])
  @@index([slug])
}

model ContentReport {
  id                String              @id @default(cuid())
  reporterUserId    String
  targetType        ModerationTargetType
  targetId          String
  targetLabel       String?
  targetUrl         String?
  reportedUserId    String?
  reportedBusinessId String?
  reasons           String[]
  details           String?
  status            ContentReportStatus @default(OPEN)
  quarantineAppliedAt DateTime?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewNotes       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  reporter          User                @relation("ContentReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reviewedBy        User?               @relation("ContentReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reportedUser      User?               @relation("ContentReportSubjectUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedBusiness  Business?           @relation("ContentReportSubjectBusiness", fields: [reportedBusinessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterUserId, createdAt])
}

model SupportRequest {
  id               String               @id @default(cuid())
  requesterUserId  String
  type             SupportRequestType
  subject          String
  body             String
  status           SupportRequestStatus @default(OPEN)
  reviewedAt       DateTime?
  reviewedByUserId String?
  adminNotes       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  requester        User                 @relation("SupportRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  reviewedBy       User?                @relation("SupportRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([requesterUserId, createdAt])
  @@index([status, createdAt])
}

model UserBlock {
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())
  blocker       User     @relation("UserBlocksCreated", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked       User     @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model BusinessBlock {
  blockerUserId    String
  blockedBusinessId String
  createdAt        DateTime @default(now())
  blocker          User     @relation("UserBlockedBusinesses", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedBusiness  Business @relation("BusinessBlockedByUsers", fields: [blockedBusinessId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedBusinessId])
  @@index([blockedBusinessId])
}

model JobIndustry {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subIndustries JobSubIndustry[]
  jobPostings   JobPosting[]

  @@index([active, sortOrder])
}

model JobSubIndustry {
  id            String       @id @default(cuid())
  industryId    String
  name          String
  slug          String
  description   String?
  active        Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  industry      JobIndustry  @relation(fields: [industryId], references: [id], onDelete: Cascade)
  jobPostings   JobPosting[]

  @@unique([industryId, slug])
  @@index([industryId, active, sortOrder])
}

model JobPosting {
  id                    String            @id @default(cuid())
  businessId            String
  createdByUserId       String
  title                 String
  slug                  String
  employmentType        JobEmploymentType @default(full_time)
  salaryMin             Int?
  salaryMax             Int?
  salaryCurrency        String?           @default("CAD")
  salaryPeriod          String?
  duties                String
  roleRequirements      String
  description           String?
  photoUrl              String?
  locationType          JobWorkplaceType
  locationProvinceCode  String?
  locationCommunitySlug String?
  locationLabel         String?
  industryId            String
  subIndustryId         String?
  status                JobStatus         @default(draft)
  publishedAt           DateTime?
  expiresAt             DateTime
  closedAt              DateTime?
  applicantCount        Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  business              Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy             User              @relation("JobPostingCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  industry              JobIndustry       @relation(fields: [industryId], references: [id])
  subIndustry           JobSubIndustry?   @relation(fields: [subIndustryId], references: [id])
  applications          JobApplication[]
  promotions            JobPromotion[]
  analyticsEvents       JobAnalyticsEvent[]

  @@unique([businessId, slug])
  @@index([status, publishedAt, expiresAt])
  @@index([locationType, locationProvinceCode, locationCommunitySlug])
  @@index([industryId, subIndustryId, status])
  @@index([businessId, status, createdAt])
}

model JobApplication {
  id              String               @id @default(cuid())
  jobPostingId    String
  applicantUserId String
  motivationHtml  String
  status          JobApplicationStatus @default(submitted)
  threadId        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  jobPosting      JobPosting           @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant       User                 @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  analyticsEvents JobAnalyticsEvent[]

  @@unique([jobPostingId, applicantUserId])
  @@index([jobPostingId, status, createdAt])
  @@index([applicantUserId, createdAt])
}

model JobAnalyticsEvent {
  id               String               @id @default(cuid())
  kind             JobAnalyticsEventKind
  businessId       String
  jobPostingId     String?
  jobApplicationId String?
  actorUserId      String?
  createdAt        DateTime             @default(now())
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobPosting       JobPosting?          @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  jobApplication   JobApplication?      @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)
  actor            User?                @relation("JobAnalyticsActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([businessId, kind, createdAt])
  @@index([jobPostingId, kind, createdAt])
}

model JobPromotion {
  id               String             @id @default(cuid())
  jobPostingId     String
  createdByUserId  String
  status           JobPromotionStatus @default(active)
  label            String             @default("$0 Limited time bonus")
  startsAt         DateTime
  endsAt           DateTime
  impressionCap    Int                @default(1000)
  impressionsServed Int               @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  jobPosting       JobPosting         @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  createdBy        User               @relation("JobPromotionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([jobPostingId, status])
  @@index([status, startsAt, endsAt])
}

model BusinessFollow {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
}

model BusinessMembership {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model StripeWebhookEvent {
  id                  String              @id @default(cuid())
  eventId             String              @unique
  eventType           String
  apiVersion          String?
  livemode            Boolean             @default(false)
  payload             Json
  status              StripeWebhookStatus @default(RECEIVED)
  subscriptionId      String?
  invoiceId           String?
  customerId          String?
  businessId          String?
  userId              String?
  lastError           String?
  retryCount          Int                 @default(0)
  lastReceivedAt      DateTime            @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([subscriptionId])
  @@index([customerId])
  @@index([businessId])
  @@index([userId])
}

