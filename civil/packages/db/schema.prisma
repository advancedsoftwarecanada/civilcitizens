generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  handle         String   @unique
  name           String?
  bio            String?  @db.Text
  avatarUrl      String?
  coverUrl       String?
  passwordHash   String
  lastLoginAt    DateTime?
  resetToken     String?   @unique
  resetExpires   DateTime?
  createdAt      DateTime @default(now())
  posts          Post[]
  comments       Comment[]
  votes          Vote[]
  commentVotes   CommentVote[]
  followers      Follow[] @relation("followers")
  following      Follow[] @relation("following")
  chamberFollows ChamberFollow[]
  experiences    Experience[]
  avatarMediaId  String?  @unique
  coverMediaId   String?  @unique
  mediaAssets    MediaAsset[] @relation("UserMediaAssets")
  avatarMedia    MediaAsset? @relation("AvatarMedia", fields: [avatarMediaId], references: [id])
  coverMedia     MediaAsset? @relation("CoverMedia", fields: [coverMediaId], references: [id])
  premiumStatus  PremiumStatus       @default(NONE)
  premiumSince   DateTime?
  premiumRenewsAt DateTime?
  premiumCanceledAt DateTime?
  premiumCancellationReason String?
  billingEmail    String?
  billingFirstName String?
  billingLastName String?
  billingCompanyName String?
  billingPhone    String?
  billingCountry  String?
  billingState    String?
  billingCity     String?
  billingAddress1 String?
  billingAddress2 String?
  billingPostalCode String?
  billingTaxId    String?
  billingNotes    String?
  stripeCustomerId String?   @unique
  stripeSubscriptionId String? @unique
  stripePriceId     String?
  premiumPaymentFingerprint String?
  businesses      Business[]
  businessMemberships BusinessMembership[]
}

model Post {
  id             String    @id @default(cuid())
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  body           String    @db.Text
  title          String?
  type           String    @default("post")
  mediaUrl       String?
  seoSlug        String?   @unique
  jurisdiction   String    @default("citizen")
  provinceCode   String?
  chamberSlug    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comments       Comment[]
  votes          Vote[]
  upvotes        Int       @default(0)
  downvotes      Int       @default(0)
  score          Int       @default(0)
  commentCount   Int       @default(0)
  hotScore       Float     @default(0)
  lastActivityAt DateTime  @default(now())
  hashtags       PostHashtag[]

  @@index([authorId, createdAt])
  @@index([provinceCode, chamberSlug, createdAt])
  @@index([jurisdiction, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  score     Int      @default(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  votes     CommentVote[]

  @@index([postId, createdAt])
  @@index([postId, parentId, createdAt])
}

model CommentVote {
  userId    String
  commentId String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model Vote {
  userId    String
  postId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Follow {
  followerId String
  targetId   String
  follower   User @relation("following", fields: [followerId], references: [id])
  target     User @relation("followers", fields: [targetId], references: [id])
  createdAt  DateTime @default(now())

  @@id([followerId, targetId])
  @@index([targetId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  actorId   String
  postId    String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model FeedEntry {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model ChamberFollow {
  id           String   @id @default(cuid())
  userId       String
  provinceCode String
  chamberSlug  String
  home         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provinceCode, chamberSlug])
  @@index([userId])
  @@index([provinceCode, chamberSlug])
}

model Hashtag {
  tag       String   @id
  createdAt DateTime @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  postId String
  tag    String
  post   Post    @relation(fields: [postId], references: [id])
  hash   Hashtag @relation(fields: [tag], references: [tag])

  @@id([postId, tag])
  @@index([tag])
}

model Experience {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean  @default(false)
  description  String?  @db.Text
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, position])
  @@index([userId, startDate])
}

model MediaAsset {
  id            String           @id @default(cuid())
  ownerId       String
  owner         User             @relation("UserMediaAssets", fields: [ownerId], references: [id], onDelete: Cascade)
  category      MediaCategory
  assetType     MediaAssetType   @default(image)
  storageType   MediaStorageType @default(minio)
  originalKey   String
  mime          String
  byteSize      Int
  width         Int?
  height        Int?
  durationMs    Int?
  checksum      String?
  status        MediaStatus      @default(pending)
  failureReason String?
  variants      Json?
  metadata      Json?
  readyAt       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  avatarOwner   User?            @relation("AvatarMedia")
  coverOwner    User?            @relation("CoverMedia")
  logoBusiness  Business?        @relation("BusinessLogoMedia")

  @@index([ownerId, category])
  @@index([status])
}

model Business {
  id              String          @id @default(cuid())
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String?         @db.Text
  logoMediaId     String?         @unique
  logoMedia       MediaAsset?     @relation("BusinessLogoMedia", fields: [logoMediaId], references: [id])
  status          BusinessStatus  @default(DRAFT)
  isVerified      Boolean         @default(false)
  stripeSubscriptionId String?    @unique
  stripePriceId   String?
  billingEmail    String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     BusinessMembership[]

  @@index([ownerId])
  @@index([slug])
  @@unique([ownerId, slug])
}

model BusinessMembership {
  id          String       @id @default(cuid())
  businessId  String
  userId      String
  role        BusinessRole @default(OWNER)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model StripeWebhookEvent {
  id            String              @id @default(cuid())
  eventId       String              @unique
  eventType     String
  apiVersion    String?
  livemode      Boolean             @default(false)
  payload       Json
  status        StripeWebhookStatus @default(RECEIVED)
  subscriptionId String?
  invoiceId     String?
  customerId    String?
  businessId    String?
  userId        String?
  lastError     String?
  retryCount    Int                 @default(0)
  lastReceivedAt DateTime           @default(now())
  processingStartedAt DateTime?
  processedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([subscriptionId])
  @@index([customerId])
  @@index([businessId])
  @@index([userId])
}

enum MediaCategory {
  avatar
  cover
  post_image
  attachment
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum MediaAssetType {
  image
  video
}

enum MediaStorageType {
  minio
  s3
}

enum PremiumStatus {
  NONE
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CANCELED
}

enum BusinessRole {
  OWNER
  MANAGER
}

enum StripeWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}
