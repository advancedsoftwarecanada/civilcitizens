generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  handle                    String               @unique
  name                      String?
  bio                       String?
  avatarUrl                 String?
  coverUrl                  String?
  passwordHash              String
  lastLoginAt               DateTime?
  resetToken                String?              @unique
  resetExpires              DateTime?
  createdAt                 DateTime             @default(now())
  avatarMediaId             String?              @unique
  coverMediaId              String?              @unique
  avatarPostId              String?              @unique
  coverPostId               String?              @unique
  billingAddress1           String?
  billingAddress2           String?
  billingCity               String?
  billingCompanyName        String?
  billingCountry            String?
  billingEmail              String?
  billingFirstName          String?
  billingLastName           String?
  billingNotes              String?
  billingPhone              String?
  billingPostalCode         String?
  billingState              String?
  billingTaxId              String?
  premiumCanceledAt         DateTime?
  premiumCancellationReason String?
  premiumPaymentFingerprint String?
  premiumRenewsAt           DateTime?
  premiumSince              DateTime?
  premiumStatus             PremiumStatus        @default(NONE)
  stripeCustomerId          String?              @unique
  stripePriceId             String?
  stripeSubscriptionId      String?              @unique
  businesses                Business[]
  businessMemberships       BusinessMembership[]
  businessFollows           BusinessFollow[]
  communityFollows          CommunityFollow[]
  comments                  Comment[]
  commentVotes              CommentVote[]
  experiences               Experience[]
  following                 Follow[]             @relation("following")
  followers                 Follow[]             @relation("followers")
  mediaAssets               MediaAsset[]         @relation("UserMediaAssets")
  posts                     Post[]
  avatarMedia               MediaAsset?          @relation("AvatarMedia", fields: [avatarMediaId], references: [id])
  coverMedia                MediaAsset?          @relation("CoverMedia", fields: [coverMediaId], references: [id])
  avatarPost                Post?                @relation("AvatarPost", fields: [avatarPostId], references: [id])
  coverPost                 Post?                @relation("CoverPost", fields: [coverPostId], references: [id])
  votes                     Vote[]
  postReactions             PostReaction[]
  friendshipsRequested      Friendship[]         @relation("friendshipsRequested")
  friendshipsReceived       Friendship[]         @relation("friendshipsReceived")
  connectionsRequested      Connection[]         @relation("connectionsRequested")
  connectionsReceived       Connection[]         @relation("connectionsReceived")
  messageParticipants       MessageParticipant[]
  messagesSent              Message[]
  communityMeta             Json?
  lastViewedHomeAt          DateTime?
  lastViewedFriendsAt       DateTime?
  lastViewedCommunitiesAt   DateTime?
}

model Post {
  id             String        @id @default(cuid())
  authorId       String
  businessId     String?
  audience       String        @default("friends")
  visibility     String        @default("public")
  body           String
  title          String?
  type           String        @default("post")
  mediaUrl       String?
  images         Json?
  seoSlug        String?       @unique
  jurisdiction   String        @default("self")
  provinceCode   String?
  communitySlug  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  upvotes        Int           @default(0)
  downvotes      Int           @default(0)
  score          Int           @default(0)
  commentCount   Int           @default(0)
  hotScore       Float         @default(0)
  reactionMaple  Int           @default(0)
  reactionHeart  Int           @default(0)
  reactionHaha   Int           @default(0)
  reactionWow    Int           @default(0)
  reactionSad    Int           @default(0)
  reactionFire   Int           @default(0)
  reactionTotal  Int           @default(0)
  recentPositive Int           @default(0)
  lastActivityAt DateTime      @default(now())
  comments       Comment[]
  author         User          @relation(fields: [authorId], references: [id])
  business       Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  avatarOwner    User?         @relation("AvatarPost")
  coverOwner     User?         @relation("CoverPost")
  hashtags       PostHashtag[]
  votes          Vote[]
  reactions      PostReaction[]
  sharedPostId   String?
  sharedPost     Post?         @relation("SharedPost", fields: [sharedPostId], references: [id])
  shares         Post[]        @relation("SharedPost")

  @@index([authorId, createdAt])
  @@index([businessId, createdAt])
  @@index([provinceCode, communitySlug, createdAt])
  @@index([jurisdiction, createdAt])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  upvotes   Int           @default(0)
  downvotes Int           @default(0)
  score     Int           @default(0)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     CommentVote[]

  @@index([postId, createdAt])
  @@index([postId, parentId, createdAt])
}

model CommentVote {
  userId    String
  commentId String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model Vote {
  userId    String
  postId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model PostReaction {
  userId    String
  postId    String
  type      ReactionType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([type])
  @@index([postId, createdAt])
}

model Follow {
  followerId String
  targetId   String
  createdAt  DateTime @default(now())
  follower   User     @relation("following", fields: [followerId], references: [id])
  target     User     @relation("followers", fields: [targetId], references: [id])

  @@id([followerId, targetId])
  @@index([targetId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  actorId   String
  postId    String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  userId    String?
  path      String
  postId    String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([postId, createdAt])
}

model Friendship {
  id           String           @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       FriendshipStatus @default(PENDING)
  requestedAt  DateTime         @default(now())
  respondedAt  DateTime?

  requester User @relation("friendshipsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("friendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Connection {
  id           String           @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       ConnectionStatus @default(PENDING)
  requestedAt  DateTime         @default(now())
  respondedAt  DateTime?

  requester User @relation("connectionsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("connectionsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model MessageThread {
  id           String             @id @default(cuid())
  type         MessageThreadType  @default(direct)
  uniqueKey    String?            @unique
  contextType  String?
  contextId    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lastMessageAt DateTime?         @default(now())
  messages     Message[]
  participants MessageParticipant[]

  @@index([lastMessageAt])
}

model MessageParticipant {
  threadId       String
  userId         String
  role           MessageParticipantRole @default(member)
  joinedAt       DateTime                @default(now())
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  lastActivityAt DateTime                @default(now())
  thread         MessageThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@index([threadId, lastActivityAt])
}

model Message {
  id          String      @id @default(cuid())
  threadId    String
  senderId    String
  body        String?
  attachments Json?
  messageType MessageType @default(text)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReactionType {
  maple
  heart
  haha
  wow
  sad
  fire
}

model FeedEntry {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model CommunityFollow {
  id           String   @id @default(cuid())
  userId       String
  provinceCode String
  communitySlug  String
  home         Boolean  @default(false)
  lastViewedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provinceCode, communitySlug])
  @@index([userId])
  @@index([provinceCode, communitySlug])
}

model Province {
  code        String   @id
  name        String
  shortName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  divisions   CensusDivision[]
  subdivisions CensusSubdivision[]
  fsas        ForwardSortationArea[]
  cities      City[]
}

model CensusDivision {
  id            String   @id
  provinceCode  String
  name          String
  type          String?
  population    Int?
  areaKm2       Float?
  centroidLat   Float?
  centroidLng   Float?
  bbox          Json?
  geometry      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  province      Province @relation(fields: [provinceCode], references: [code])
  subdivisions  CensusSubdivision[]
  fsas          ForwardSortationArea[]

  @@index([provinceCode])
}

model CensusSubdivision {
  id                  String   @id
  provinceCode        String
  divisionId          String
  name                String
  type                String?
  slug                String
  officialName        String?
  population          Int?
  areaKm2             Float?
  centroidLat         Float?
  centroidLng         Float?
  bbox                Json?
  geometry            Json?
  defaultCommunitySlug  String?
  defaultCommunityName  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  province            Province       @relation(fields: [provinceCode], references: [code])
  division            CensusDivision @relation(fields: [divisionId], references: [id])
  cities              City[]
  fsas                ForwardSortationArea[]

  @@unique([provinceCode, slug])
  @@index([provinceCode])
  @@index([divisionId])
}

model ForwardSortationArea {
  code               String  @id
  provinceCode       String
  divisionId         String?
  subdivisionId      String?
  subdivisionName    String?
  centroidLat        Float?
  centroidLng        Float?
  bbox               Json?
  geometry           Json?
  defaultCommunitySlug String?
  defaultCommunityName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  province           Province?        @relation(fields: [provinceCode], references: [code])
  division           CensusDivision?  @relation(fields: [divisionId], references: [id])
  subdivision        CensusSubdivision? @relation(fields: [subdivisionId], references: [id])

  @@index([provinceCode])
  @@index([divisionId])
  @@index([subdivisionId])
}

model City {
  id              String   @id @default(cuid())
  provinceCode    String
  name            String
  slug            String
  communitySlug   String
  communityName   String
  latitude        Float
  longitude       Float
  population      Int?
  source          String   @default("geonames_ca")
  sourceId        String
  featureClass    String?
  featureCode     String?
  matchMethod     String
  matchConfidence String
  matchDistanceKm Float?
  censusSubdivisionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  censusSubdivision CensusSubdivision? @relation(fields: [censusSubdivisionId], references: [id])
  province Province? @relation(fields: [provinceCode], references: [code])

  @@unique([provinceCode, slug])
  @@unique([source, sourceId])
  @@index([communitySlug])
  @@index([provinceCode])
  @@index([latitude, longitude])
  @@index([censusSubdivisionId])
}

model Hashtag {
  tag       String        @id
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  postId String
  tag    String
  post   Post    @relation(fields: [postId], references: [id])
  hash   Hashtag @relation(fields: [tag], references: [tag])

  @@id([postId, tag])
  @@index([tag])
}

model Experience {
  id           String    @id @default(cuid())
  userId       String
  title        String
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String?
  position     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([userId, startDate])
}

model MediaAsset {
  id            String           @id @default(cuid())
  ownerId       String
  category      MediaCategory
  assetType     MediaAssetType   @default(image)
  storageType   MediaStorageType @default(minio)
  originalKey   String
  mime          String
  byteSize      Int
  width         Int?
  height        Int?
  durationMs    Int?
  checksum      String?
  status        MediaStatus      @default(pending)
  failureReason String?
  variants      Json?
  metadata      Json?
  readyAt       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  logoBusiness  Business?        @relation("BusinessLogoMedia")
  coverBusiness Business?        @relation("BusinessCoverMedia")
  owner         User             @relation("UserMediaAssets", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOwner   User?            @relation("AvatarMedia")
  coverOwner    User?            @relation("CoverMedia")

  @@index([ownerId, category])
  @@index([status])
}

model Business {
  id                   String               @id @default(cuid())
  ownerId              String
  provinceCode         String?
  communitySlug        String?
  name                 String
  slug                 String
  type                 BusinessType         @default(LOCAL_BUSINESS)
  description          String?
  phone                String?
  websiteUrl           String?
  address              String?
  schedule             String?
  logoMediaId          String?              @unique
  coverMediaId         String?              @unique
  status               BusinessStatus       @default(DRAFT)
  isVerified           Boolean              @default(false)
  logoUrl              String?
  coverUrl             String?
  stripeSubscriptionId String?              @unique
  stripePriceId        String?
  billingEmail         String?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  logoMedia            MediaAsset?          @relation("BusinessLogoMedia", fields: [logoMediaId], references: [id])
  coverMedia           MediaAsset?          @relation("BusinessCoverMedia", fields: [coverMediaId], references: [id])
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships          BusinessMembership[]
  follows              BusinessFollow[]
  posts                Post[]

  @@unique([provinceCode, communitySlug, slug])
  @@index([ownerId])
  @@index([provinceCode, communitySlug])
  @@index([slug])
}

model BusinessFollow {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
}

model BusinessMembership {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model StripeWebhookEvent {
  id                  String              @id @default(cuid())
  eventId             String              @unique
  eventType           String
  apiVersion          String?
  livemode            Boolean             @default(false)
  payload             Json
  status              StripeWebhookStatus @default(RECEIVED)
  subscriptionId      String?
  invoiceId           String?
  customerId          String?
  businessId          String?
  userId              String?
  lastError           String?
  retryCount          Int                 @default(0)
  lastReceivedAt      DateTime            @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([subscriptionId])
  @@index([customerId])
  @@index([businessId])
  @@index([userId])
}

enum MediaCategory {
  avatar
  cover
  business_logo
  business_cover
  post_image
  attachment
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum MediaAssetType {
  image
  video
}

enum MediaStorageType {
  minio
  s3
}

enum PremiumStatus {
  NONE
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CANCELED
}

enum BusinessType {
  LOCAL_BUSINESS
  NON_PROFIT
  COMMUNITY_GROUP
  EDUCATIONAL
  RELIGIOUS
  GOVERNMENT
  ARTS_CULTURE
  SPORTS_RECREATION
}

enum BusinessRole {
  OWNER
  MANAGER
}

enum StripeWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum MessageThreadType {
  direct
  group
  order
  job
  support
}

enum MessageParticipantRole {
  member
  admin
  system
}

enum MessageType {
  text
  system
}
