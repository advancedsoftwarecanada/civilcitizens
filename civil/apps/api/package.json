{
  "name": "@civil/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @civil/db build && pnpm --filter @civil/shared build && pnpm --filter @civil/db generate && concurrently -k -n db,shared,prisma,api \"pnpm --filter @civil/db dev\" \"pnpm --filter @civil/shared dev\" \"chokidar ../../packages/db/schema.prisma -c 'pnpm --filter @civil/db generate'\" \"tsx watch src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier -w .",
    "seed:cities": "tsx scripts/seed-cities.ts",
    "seed:admin": "tsx scripts/seed-admin-areas.ts",
    "link:cities-subdivisions": "tsx scripts/link-cities-subdivisions.ts",
    "watch:seed-log": "tsx scripts/watch-seed-log.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.587.0",
    "@aws-sdk/s3-request-presigner": "^3.587.0",
    "@civil/db": "workspace:*",
    "@civil/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@prisma/client": "^6.19.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/centroid": "^7.2.0",
    "@turf/distance": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/point-to-polygon-distance": "^7.2.0",
    "@types/geojson": "^7946.0.15",
    "@types/node": "^20.12.12",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.2",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "fastify-sse-v2": "^3.1.2",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "proj4": "^2.11.0",
    "shapefile": "^0.6.6",
    "stripe": "^16.11.0",
    "unzipper": "^0.11.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.0.15"
  }
}
