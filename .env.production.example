# Civil Citizens production environment template

CIVIL_PROD_HOST=civilcitizens.ca

POSTGRES_HOST_PORT=5432
POSTGRES_GIS_HOST_PORT=5433
REDIS_HOST_PORT=6379
NGINX_HTTP_PORT=80
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/civil
PRISMA_SKIP_MIGRATE=false

NEXT_PUBLIC_BASE_URL=https://civilcitizens.ca
NEXT_PUBLIC_MEDIA_BASE_URL=https://civilcitizens.ca/media
MEDIA_PUBLIC_BASE_URL=https://civilcitizens.ca/media
