NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_CIVIL_ADMIN_EMAILS=
CIVIL_ADMIN_EMAILS=

POSTGRES_DATA_DIR=/var/lib/civil/postgres
POSTGRES_GIS_DATA_DIR=/var/lib/civil/postgres-gis
REDIS_DATA_DIR=/var/lib/civil/redis
MINIO_DATA_DIR=/var/lib/civil/minio

MAP_TILE_SERVER=https://civilcitizens.ca/maps
OSRM_SERVER=https://civilcitizens.ca/osrm
NOMINATIM_SERVER=https://civilcitizens.ca/nominatim
