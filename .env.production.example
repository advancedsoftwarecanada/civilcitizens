MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

STRIPE_MODE=live
STRIPE_PUBLIC_KEY=REPLACE_STRIPE_LIVE_PUBLIC_KEY
STRIPE_SECRET_KEY=REPLACE_STRIPE_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_PREMIUM_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_BUSINESS_MONTHLY=price_REPLACE_ME
