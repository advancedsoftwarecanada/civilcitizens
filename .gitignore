# Monorepo ignores

# Node & package managers
node_modules/
**/node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/*.log
**/.pnpm/
**/.pnpm-store/

# TypeScript
**/*.tsbuildinfo

# Next.js
**/.next/
**/.next/cache/
**/out/

# Build outputs
**/dist/
**/build/
**/.turbo/
**/.cache/

# Tests/coverage
**/coverage/
**/.nyc_output/

# Env files (keep examples)
.env
.env.*
!*.env.example
**/.env
**/.env.*
!**/.env.example
!.env.production
!**/.env.production

# OS/editor misc
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Docker local caches/data (not volumes)
**/.docker/
**/.docker-cache/
**/docker-data/

# Runtime uploads/temp (kept via placeholder readme)
uploads/
!uploads/README.md
node_modules/

# Large geodata archives (tracked elsewhere)
_geodata/

# Large SQL exports
tests/*.sql

