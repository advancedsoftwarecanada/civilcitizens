# Monorepo ignores

# Node & package managers
node_modules/
**/node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/*.log
**/.pnpm/
**/.pnpm-store/

# TypeScript
**/*.tsbuildinfo

# Python
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc

# Next.js
**/.next/
**/.next/cache/
**/out/

# Next.js (local build variants)
**/.next*

# Build outputs
**/dist/
**/build/
**/.turbo/
**/.cache/

# Tests/coverage
**/coverage/
**/.nyc_output/

# OS/editor misc
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Docker local caches/data (not volumes)
**/.docker/
**/.docker-cache/
**/docker-data/

# Runtime uploads/temp (kept via placeholder readme)
uploads/
!uploads/README.md
node_modules/

# Local temporary folders
tmp/
tmp_*/
**/tmp/
**/tmp_*/

# Large geodata archives (tracked elsewhere)
_geodata/
/civilcitizens_largefiles/

# Large SQL exports
tests/*.sql
