# Monorepo ignores

# Node & package managers
node_modules/
**/node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/*.log
**/.pnpm/
**/.pnpm-store/

# TypeScript
**/*.tsbuildinfo

# Python
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc

# Next.js
**/.next/
**/.next/cache/
**/out/

# Next.js (local build variants)
**/.next*

# Build outputs
**/dist/
**/build/
**/.turbo/
**/.cache/

# Tests/coverage
**/coverage/
**/.nyc_output/

# Generated local Prisma env
civil/packages/db/.env

# Local environment files
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# OS/editor misc
.DS_Store
Thumbs.db
*:Zone.Identifier
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Docker local caches/data (not volumes)
**/.docker/
**/.docker-cache/
**/docker-data/

# Runtime uploads/temp (kept via placeholder readme)
uploads/
!uploads/README.md
node_modules/

# Local temporary folders
tmp/
tmp_*/
**/tmp/
**/tmp_*/

# Large geodata archives (tracked elsewhere)
_geodata/
/civilcitizens_largefiles/

# Large SQL exports
tests/*.sql

# Generated TLS/certbot assets
ssl/letsencrypt/
ssl/letsencrypt-lib/
ssl/letsencrypt-log/
ssl/*.crt
ssl/*.key

# Local deployment and signing secrets
_production_server/ssh.txt
_production_server/host.txt
_production_server/user.txt
_production_server/*.pem
_production_server/*.key
civil/secrets/
builds/mobile/capacitor/android/app/google-services.json
**/google-services.json
**/GoogleService-Info.plist
**/*.apk
**/*.aab
