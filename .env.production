# Mobile push (device token registration + APNs delivery)
# - `PUSH_REGISTER_SECRET` must match the iOS app's `x-register-secret` (Info.plist)
# - `PUSH_ADMIN_SECRET` must match what the `push` service expects for `/send-test`
PUSH_REGISTER_SECRET=dev_push_register_secret
PUSH_ADMIN_SECRET=dev_push_admin_secret
PUSH_DELIVERY_URL=http://push:8787

# APNs sender (required by the `push` service for actually sending notifications)
# Put your AuthKey_XXXX.p8 file inside APNS_KEY_DIR on the host.
APNS_KEY_DIR=./secrets/apns
APNS_KEY_FILENAME=AuthKey.p8
APNS_KEY_ID=5369634SJS
APNS_TEAM_ID=ZHZD5G948K
# Must match iOS app bundle id / APNs topic
APNS_BUNDLE_ID=com.civilcitizens.app
APNS_USE_SANDBOX=false

